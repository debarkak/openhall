# OpenHall Database Connection
# SQLite (default single-stack local self-hosting):
DATABASE_URL="file:./openhall.db"

# PostgreSQL (optional enterprise multi-tenant cluster):
# DATABASE_URL="postgresql://openhall:secret@localhost:5432/openhall?schema=public"

# Host Port
PORT=3000

# Required for production sessions. Generate a unique value with:
# openssl rand -base64 48
# SESSION_SECRET=

# Required when initializing production accounts (12+ characters each):
# INITIAL_TEACHER_PASSWORD=
# INITIAL_STUDENT_PASSWORD=
